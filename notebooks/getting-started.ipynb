   "outputs": [],
   "source": [
    "print(\"Current Catalog Configuration:\")\n",
    "print(f\"spark.sql.defaultCatalog: {spark.conf.get('spark.sql.defaultCatalog', 'Not Set')}\")\n",
    "print(f\"spark.sql.catalog.data.catalog-impl: {spark.conf.get('spark.sql.catalog.data.catalog-impl', 'Not Set')}\")\n",
    "print(f\"spark.sql.catalog.data: {spark.conf.get('spark.sql.catalog.data', 'Not Set')}\")\n",
    "print(f\"spark.sql.catalog.data.uri: {spark.conf.get('spark.sql.catalog.data.uri', 'Not Set')}\")\n",
    "print(f\"spark.sql.catalog.data.warehouse: {spark.conf.get('spark.sql.catalog.data.warehouse', 'Not Set')}\")\n",
    "print(f\"spark.sql.catalogImplementation: {spark.conf.get('spark.sql.catalogImplementation', 'Not Set')}\")\n",
    "print(f\"spark.sql.catalog.data.s3.endpoint: {spark.conf.get('spark.sql.catalog.data.s3.endpoint', 'Not Set')}\")\n",
    "print(f\"spark.sql.catalog.data.io-impl: {spark.conf.get('spark.sql.catalog.data.io-impl', 'Not Set')}\")\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
